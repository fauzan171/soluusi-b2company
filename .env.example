APP_NAME="Klinik Konsultan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# prod: mysql (DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD)

BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Midtrans (sandbox dev, prod live)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_3DS=true

# Xendit (split Marketplace)
SECRET_KEY_XENDIT=

# Google Calendar — START OAuth-user (copy B2C), MIGRATE service account (§15.11)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_SERVICE_ACCOUNT_SUBJECT=

# Socialite SSO (admin klinik + konsultan login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Mail (white-label from = klinik brand, bukan Soluusi)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@klinik-brand.id"
MAIL_FROM_NAME="${APP_NAME}"

# B2B-new
WHITE_LABEL_DEFAULT_BRAND="Klinik Konsultan"
WHITE_LABEL_DOMAIN=localhost:8000
SPLIT_PROVIDER=midtrans_connect
SPLIT_ON=false
HAP_TOTAL_RATE=1000000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
